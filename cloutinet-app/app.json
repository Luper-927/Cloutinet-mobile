{
  "expo": {
    "name": "Cloutinet",
    "slug": "cloutinet-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cloutinet-icon.png",
    "scheme": "cloutinetapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#020B33",
        "foregroundImage": "./assets/images/cloutinet-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cloutinet.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#020B33",
          "image": "./assets/images/cloutinet-icon-foreground.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c362cc40-aad4-4088-94a9-eaca51e53575"
      }
    },
    "owner": "luper927s-team"
  }
}
